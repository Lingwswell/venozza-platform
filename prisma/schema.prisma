generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Assinatura (SaaS). Redes antigas ficam "active" e nada muda para elas.
  // status: trial | active | past_due | suspended | canceled
  status              String    @default("active")
  planId              String?
  trialEndsAt         DateTime?
  pastDueSince        DateTime?
  suspendedReason     String?
  billingName         String?
  billingEmail        String?
  billingDocument     String?
  asaasCustomerId     String?
  asaasSubscriptionId String?   @unique
  // Valor mensal enviado ao Asaas (para saber quando atualizar).
  billingValueCents   Int?
  // Marca no site
  logoUrl             String?
  brandColor          String?
  onboardedAt         DateTime?

  plan     Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  invoices Invoice[]
  addons   TenantAddon[]

  stores       Store[]
  users        User[]
  orders       Order[]
  categories   Category[]
  optionGroups OptionGroup[]
  optionItems  OptionItem[]
  domains      TenantDomain[]
  products     Product[]
  promotions   Promotion[]

  ingredients     Ingredient[]
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  supplyRequests  SupplyRequest[]

  @@map("tenants")
}

// Dominios de cada rede (ex.: "pedidos.venozza.com.br"). O app/site descobre
// a rede pelo dominio acessado; a loja e escolhida dentro da rede.
model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  host      String   @unique
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

model Store {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String
  slug                 String
  addressStreet        String?
  addressNumber        String?
  addressComplement    String?
  addressNeighborhood  String?
  city                 String?
  state                String?
  zipCode              String?
  latitude             Decimal?
  longitude            Decimal?
  deliveryRadiusKm     Decimal?
  deliveryBaseFeeCents Int?
  deliveryKmFeeCents   Int?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant                    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                     User[]
  orders                    Order[]
  productStores             ProductStore[]
  storeOptionAvailabilities StoreOptionAvailability[]
  settings                  StoreSettings?
  userStores                UserStore[]
  supplyRequests            SupplyRequest[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("stores")
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  storeId   String?
  name      String
  email     String   @unique
  password  String
  role      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Loja principal (usada como padrao). As lojas que o usuario acessa ficam em stores.
  store  Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  stores UserStore[]

  @@index([tenantId])
  @@index([storeId])
  @@map("users")
}

// Lojas que um usuario pode acessar (franqueado com varias lojas, gerente, operador).
// Dono da rede e super_admin acessam todas as lojas da rede e nao precisam de linhas aqui.
model UserStore {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("user_stores")
}

model Category {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  icon         String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  showInMobile Boolean  @default(true)
  showInSite   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryOptionGroups CategoryOptionGroup[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([active])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id                  String               @id @default(cuid())
  tenantId            String?
  name                String
  price_cents         Int
  storeId             String
  createdAt           DateTime             @default(now())
  available           Boolean              @default(true)
  category            String
  customizationType   String               @default("auto")
  description         String?
  image               String?
  productStores       ProductStore[]
  productOptionGroups ProductOptionGroup[]
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotions          Promotion[]
  recipeItems         RecipeItem[]

  @@index([tenantId])
}

// Promocoes do Marketing. Viram baloes no site e no app.
// kind "notice" = so aviso; kind "discount" = preco promocional cobrado pelo servidor
// (vale sobre o preco base do produto; tamanho, borda e bebidas seguem normais).
model Promotion {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  message       String?
  kind          String    @default("notice")
  productId     String?
  discountType  String?
  discountValue Int?
  color         String    @default("#B91C1C")
  emoji         String?
  storeIds      String[]  @default([])
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, active])
  @@map("promotions")
}

// Regras operacionais da loja. Tudo que o app/site/checkout precisa saber
// sobre a loja (aberta?, frete, pedido minimo, pagamentos, horarios) vem daqui.
model StoreSettings {
  id                     String   @id @default(cuid())
  storeId                String   @unique
  manualClosed           Boolean  @default(false)
  closedMessage          String?
  timezone               String   @default("America/Sao_Paulo")
  openingHours           Json?
  deliveryTimeMinMinutes Int      @default(30)
  deliveryTimeMaxMinutes Int      @default(45)
  minimumOrderCents      Int      @default(0)
  deliveryFeeCents       Int      @default(500)
  freeDeliveryAboveCents Int?
  whatsapp               String?
  paymentPix             Boolean  @default(true)
  paymentCash            Boolean  @default(true)
  paymentCredit          Boolean  @default(false)
  paymentDebit           Boolean  @default(false)
  // Cliente pode escolher retirar na loja.
  pickupEnabled          Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model ProductStore {
  id          String   @id @default(cuid())
  productId   String
  storeId     String
  available   Boolean  @default(true)
  stock       Int      @default(0)
  price_cents Int?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
  @@index([available])
  @@map("product_stores")
}

model OptionGroup {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  type        String   @default("generic")
  required    Boolean  @default(false)
  minSelect   Int      @default(0)
  maxSelect   Int      @default(1)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                OptionItem[]
  productOptionGroups  ProductOptionGroup[]
  categoryOptionGroups CategoryOptionGroup[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([active])
  @@index([sortOrder])
  @@map("option_groups")
}

model OptionItem {
  id            String   @id @default(cuid())
  tenantId      String
  optionGroupId String
  name          String
  slug          String
  description   String?
  price_cents   Int      @default(0)
  // Proporcao da ficha tecnica para tamanhos (ex.: broto 0.5, grande 1, familia 1.3).
  stockFactor   Float?
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant                    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionGroup               OptionGroup               @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  recipeItems               RecipeItem[]
  storeOptionAvailabilities StoreOptionAvailability[]

  @@unique([optionGroupId, slug])
  @@index([tenantId])
  @@index([optionGroupId])
  @@index([active])
  @@index([sortOrder])
  @@map("option_items")
}

model ProductOptionGroup {
  id            String   @id @default(cuid())
  productId     String
  optionGroupId String
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, optionGroupId])
  @@index([productId])
  @@index([optionGroupId])
  @@index([active])
  @@index([sortOrder])
  @@map("product_option_groups")
}

model CategoryOptionGroup {
  id            String   @id @default(cuid())
  categoryId    String
  optionGroupId String
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@unique([categoryId, optionGroupId])
  @@index([categoryId])
  @@index([optionGroupId])
  @@index([active])
  @@index([sortOrder])
  @@map("category_option_groups")
}

model StoreOptionAvailability {
  id           String   @id @default(cuid())
  storeId      String
  optionItemId String
  available    Boolean  @default(true)
  stock        Int?
  price_cents  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  optionItem OptionItem @relation(fields: [optionItemId], references: [id], onDelete: Cascade)

  @@unique([storeId, optionItemId])
  @@index([storeId])
  @@index([optionItemId])
  @@index([available])
  @@map("store_option_availabilities")
}

model Order {
  id             String   @id @default(cuid())
  orderCode      String   @unique
  tenantId       String
  storeId        String
  customerName   String
  phone          String
  address        String
  notes          String?
  subtotal_cents Int
  freight_cents  Int
  total_cents    Int
  paymentMethod  String
  // entrega | retirada
  orderType      String   @default("entrega")
  status         String   @default("novo")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([tenantId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  name        String
  quantity    Int
  price_cents Int
  total_cents Int
  note        String?
  size        String?
  crust       String?
  addons_json String?
  // Sabores do meio a meio (ids dos produtos), para a baixa de estoque.
  flavorIds   String[] @default([])
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ===== Estoque de insumos =====
// Quantidades sempre na unidade base do insumo: g (peso), ml (volume) ou un.
// "location" = id da loja ou "central" (cozinha central da rede).

model Ingredient {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  unit            String   @default("g")
  // Minimo padrao nas lojas (ex.: 500 g) e quanto pedir a central quando passa dele.
  minStore        Float?
  reorderQuantity Float?
  // Custo em centavos por kg (g), por litro (ml) ou por unidade (un).
  costCents       Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeItems     RecipeItem[]
  stockLevels     StockLevel[]
  movements       StockMovement[]
  supplyItems     SupplyRequestItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("ingredients")
}

// Ficha tecnica: quanto de cada insumo um produto (ou uma opcao, como a borda) gasta.
model RecipeItem {
  id           String   @id @default(cuid())
  tenantId     String
  ingredientId String
  productId    String?
  optionItemId String?
  quantity     Float
  createdAt    DateTime @default(now())

  ingredient Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionItem OptionItem? @relation(fields: [optionItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([optionItemId])
  @@map("recipe_items")
}

model StockLevel {
  id           String   @id @default(cuid())
  tenantId     String
  ingredientId String
  location     String
  quantity     Float    @default(0)
  // Minimo so deste local; vazio = usa o minimo padrao do insumo (lojas).
  minQuantity  Float?
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, location])
  @@index([tenantId, location])
  @@map("stock_levels")
}

// Historico: entrada, venda, estorno, ajuste, contagem, perda, abastecimento.
model StockMovement {
  id              String   @id @default(cuid())
  tenantId        String
  ingredientId    String
  location        String
  type            String
  quantity        Float
  orderId         String?
  supplyRequestId String?
  note            String?
  userId          String?
  createdAt       DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([tenantId, location, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

// Pedido de abastecimento da loja para a cozinha central.
// status: aberto -> separando -> enviado -> recebido (ou cancelado). origin: alerta | manual.
model SupplyRequest {
  id        String   @id @default(cuid())
  tenantId  String
  storeId   String
  status    String   @default("aberto")
  origin    String   @default("alerta")
  note      String?
  sentAt     DateTime?
  receivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items  SupplyRequestItem[]

  @@index([tenantId, status])
  @@index([storeId, status])
  @@map("supply_requests")
}

model SupplyRequestItem {
  id                String  @id @default(cuid())
  requestId         String
  ingredientId      String
  quantityRequested Float
  quantitySent      Float?
  quantityReceived  Float?

  request    SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([requestId, ingredientId])
  @@map("supply_request_items")
}

// ===== Camada SaaS =====

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  // Valor mensal por loja ativa, em centavos.
  priceCents  Int
  trialDays   Int      @default(14)
  // Sem preco de loja extra: limite de lojas. Com preco de loja extra: lojas incluidas no valor do plano.
  maxStores   Int?
  extraStorePriceCents Int?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants Tenant[]

  @@map("plans")
}

// Fatura da rede (do Asaas ou lancada a mao pelo super admin).
// status: pending | paid | overdue | canceled | refunded
model Invoice {
  id          String    @id @default(cuid())
  tenantId    String
  amountCents Int
  status      String    @default("pending")
  dueDate     DateTime
  paidAt      DateTime?
  externalId  String?   @unique
  invoiceUrl  String?
  billingType String?
  description String?
  // subscription (mensalidade) | one_off (cobranca unica: implantacao, servico)
  kind        String    @default("subscription")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("invoices")
}

// Eventos do webhook ja processados (o Asaas pode mandar o mesmo mais de uma vez).
model BillingEvent {
  id        String   @id
  event     String
  createdAt DateTime @default(now())

  @@map("billing_events")
}

// Recursos avulsos com valor mensal (somam na mensalidade da rede).
// feature: recurso que so aparece para quem contratou (estoque, promocoes). Vazio = so cobranca.
model Addon {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  priceCents  Int
  feature     String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants TenantAddon[]

  @@map("addons")
}

model TenantAddon {
  id        String   @id @default(cuid())
  tenantId  String
  addonId   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addon  Addon  @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([tenantId, addonId])
  @@map("tenant_addons")
}
