export type CartItem = {
  id: number;
  name: string;
  price: number;
  quantity: number;
  image?: string;
  note?: string;
  addons?: string[];
  size?: string;
  crust?: string;
};

export type Order = {
  customerName: string;
  phone: string;
  address: string;
  notes?: string;
  items: CartItem[];
  subtotal?: number;
  deliveryFee?: number;
  total: number;
  paymentMethod?: string;
};
