export type CartItem = {
  id: number;
  name: string;
  price: string;
  image: string;
  quantity: number;
  note?: string;
  addons?: string[];
};

export type CreateOrderPayload = {
  customerName: string;
  phone: string;
  address: string;
  notes?: string;
  items: CartItem[];
  total: number;
};

export type SavedOrder = CreateOrderPayload & {
  orderId: string;
  createdAt: string;
  status: "novo";
};
