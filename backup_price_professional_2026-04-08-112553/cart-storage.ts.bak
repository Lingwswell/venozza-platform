export const CART_KEY = "venozza_cart";

export type CartItem = {
  id: number | string;
  name: string;
  price: string;
  image?: string;
  quantity: number;
import { parsePrice } from "../utils/formatters";
  note?: string;
  addons?: string[];
};

function isBrowser() {
  return typeof window !== "undefined";
}

export function readCart(): CartItem[] {
  if (!isBrowser()) return [];

  try {
    const raw = localStorage.getItem(CART_KEY);
    if (!raw) return [];

    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];

    return parsed
      .filter(Boolean)
      .map((item) => ({
        ...item,
        quantity: Number(item.quantity || 1),
        price: parsePrice(item.price),
        addons: Array.isArray(item.addons) ? item.addons : [],
      }));
  } catch {
    return [];
  }
}

export function saveCart(items: CartItem[]) {
  if (!isBrowser()) return;
  localStorage.setItem(CART_KEY, JSON.stringify(items));
}

export function getCartItems() {
  return readCart();
}

export function getCartCount() {
  return readCart().reduce((sum, item) => sum + Number(item.quantity || 0), 0);
}

export function clearCart() {
  if (!isBrowser()) return;
  localStorage.removeItem(CART_KEY);
}

export function addToCart(item: Omit<CartItem, "quantity"> & { quantity?: number }) {
  const items = readCart();
  const index = items.findIndex((cartItem) => cartItem.id === item.id);

  if (index >= 0) {
    items[index].quantity += Number(item.quantity || 1);
  } else {
    items.push({
      ...item,
      quantity: Number(item.quantity || 1),
      price: parsePrice(item.price),
      addons: Array.isArray(item.addons) ? item.addons : [],
    });
  }

  saveCart(items);
  return items;
}

export function incrementCartItem(id: number | string) {
  const items = readCart().map((item) =>
    item.id === id ? { ...item, quantity: item.quantity + 1 } : item
  );
  saveCart(items);
  return items;
}

export function decrementCartItem(id: number | string) {
  const items = readCart()
    .map((item) =>
      item.id === id ? { ...item, quantity: item.quantity - 1 } : item
    )
    .filter((item) => item.quantity > 0);

  saveCart(items);
  return items;
}

export function removeCartItem(id: number | string) {
  const items = readCart().filter((item) => item.id !== id);
  saveCart(items);
  return items;
}

export function incrementItem(id: number | string) {
  return incrementCartItem(id);
}

export function decrementItem(id: number | string) {
  return decrementCartItem(id);
}

export function removeFromCart(id: number | string) {
  return removeCartItem(id);
}
