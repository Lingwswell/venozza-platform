const produtos: Produto[] = [
  // Pizzas
  { id: 1,  cat: "pizzas",     emoji: "🍕", nome: "Margherita Clássica",  desc: "Molho de tomate, mussarela fior di latte e manjericão fresco", preco: 49, tag: "Mais pedida" },
  { id: 2,  cat: "pizzas",     emoji: "🔥", nome: "Calabresa Artesanal",  desc: "Calabresa fatiada, cebola roxa caramelizada e orégano especial", preco: 54, tag: null },
  { id: 3,  cat: "pizzas",     emoji: "🥩", nome: "Carne de Sol",         desc: "Carne de sol desfiada, catupiry, cebola e coentro", preco: 62, tag: "Novidade" },
