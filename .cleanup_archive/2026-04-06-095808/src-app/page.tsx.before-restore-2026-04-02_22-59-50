  // Sobremesas
  { id: 16, cat: "sobremesas", emoji: "🍫", nome: "Petit Gâteau",         desc: "Com sorvete de creme e calda de chocolate", preco: 22, tag: "Mais pedida" },
  { id: 17, cat: "sobremesas", emoji: "🍨", nome: "Brownie com Sorvete",  desc: "Brownie quente com sorvete de baunilha", preco: 18, tag: null },
  // Novidades
  { id: 18, cat: "novidades",  emoji: "🌶️", nome: "Pizza Spicy Lover",   desc: "Calabresa, pimenta biquinho, jalapeño e mel de pimenta", preco: 64, tag: "Novo" },
  { id: 19, cat: "novidades",  emoji: "🥓", nome: "Pizza Bacon Smash",    desc: "Bacon crocante, cheddar, cebola crispy e molho barbecue", preco: 66, tag: "Novo" },
];

type Produto = {
  id: number; cat: string; emoji: string; nome: string;
  desc: string; preco: number; tag: string | null;
};
type CartItem = { id: number; nome: string; preco: number; qty: number };

export default function HomePage() {
  const [cart, setCart] = useState<CartItem[]>([]);
  const [cartOpen, setCartOpen] = useState(false);
  const [modo, setModo] = useState<"delivery" | "retirada">("delivery");
  const [catAtiva, setCatAtiva] = useState("pizzas");

  const totalItems = cart.reduce((s, i) => s + i.qty, 0);
  const totalPreco = cart.reduce((s, i) => s + i.preco * i.qty, 0);

  // Horário de funcionamento: 18:00 – 23:30
  const agora = new Date();
  const minutosTotais = agora.getHours() * 60 + agora.getMinutes();
  const ABRE_MIN = 18 * 60;       // 18:00
  const FECHA_MIN = 23 * 60 + 30; // 23:30
  const aberto = minutosTotais >= ABRE_MIN && minutosTotais < FECHA_MIN;
  const statusTexto = aberto
    ? "Aberta agora · até 23:30"
    : minutosTotais < ABRE_MIN
    ? "Fechada · Abre às 18:00"
    : "Fechada · Abre amanhã às 18:00";


  function addToCart(pizza: Produto) {
    setCart((prev) => {
      const exists = prev.find((i) => i.id === pizza.id);
      if (exists) return prev.map((i) => i.id === pizza.id ? { ...i, qty: i.qty + 1 } : i);
      return [...prev, { id: pizza.id, nome: pizza.nome, preco: pizza.preco, qty: 1 }];
    });
  }

  function removeFromCart(id: number) {
    setCart((prev) =>
      prev.map((i) => i.id === id ? { ...i, qty: i.qty - 1 } : i).filter((i) => i.qty > 0)
    );
  }

  function qtyOf(id: number) {
    return cart.find((i) => i.id === id)?.qty ?? 0;
  }

  return (
    <main className="min-h-screen bg-[#0f0a06] text-white">

      {/* Grain overlay */}
      <div className="pointer-events-none fixed inset-0 z-0 opacity-[0.03] bg-[url('data:image/svg+xml;base64,')]" aria-hidden />
      <div className="pointer-events-none fixed inset-0 z-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-5%,#7c2d0e33,transparent)]" aria-hidden />

      {/* ── NAV SUPERIOR ── */}
      <nav className="sticky top-0 z-50 border-b border-neutral-800/60 bg-[#0f0a06]/90 backdrop-blur">
        {/* Linha 1: logo + status + links + carrinho + auth */}
        <div className="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3 md:px-8">

          {/* Logo + status abaixo */}
          <div className="flex shrink-0 flex-col gap-0.5 leading-none">
            <div className="flex items-center gap-1.5">
              <span className="text-lg" aria-hidden>🍕</span>
              <span className="text-base font-black tracking-tight text-orange-400">VenoZza</span>
            </div>

            {/* Status com tooltip via group-hover */}
            <div className="group relative ml-6 flex items-center gap-1 cursor-default">
              <span
                className={`h-1.5 w-1.5 rounded-full transition-colors ${
                  aberto ? "animate-pulse bg-emerald-400" : "bg-red-500"
                }`}
              />
              <span
                className={`text-[10px] font-semibold transition-colors ${
                  aberto ? "text-emerald-400" : "text-red-400"
                }`}
              >
                {statusTexto}
              </span>

              {/* Balão — aparece com group-hover, renderizado sempre no DOM */}
              <div className="pointer-events-none absolute bottom-[calc(100%+8px)] left-0 z-[999] w-max opacity-0 transition-opacity duration-150 group-hover:opacity-100">
                <div
                  className={`rounded-lg px-3 py-2 text-xs font-semibold shadow-xl ${
                    aberto
                      ? "bg-emerald-500 text-white"
                      : "bg-neutral-800 text-neutral-200 border border-neutral-700"
                  }`}
                >
                  {aberto
                    ? "🍕 Pode pedir! Estamos abertos até 23:30"
                    : "😴 Fechados agora · voltamos às 18:00"}
                </div>
                {/* setinha apontando para baixo */}
                <div
                  className={`ml-3 h-0 w-0 border-x-[5px] border-x-transparent border-t-[5px] ${
                    aberto ? "border-t-emerald-500" : "border-t-neutral-800"
                  }`}
                />
              </div>
            </div>
          </div>

          {/* Links centrais */}
          <div className="hidden items-center gap-1 md:flex">
            <a href="#" className="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-white hover:bg-neutral-800 transition-colors">
              <span className="text-base">🏠</span> Home
            </a>
            <a href="#cardapio" className="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors">
              <span className="text-base">📋</span> Cardápio
            </a>
            <a href="#" className="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors">
              <span className="text-base">🎟️</span> Cupons
            </a>
          </div>

          {/* Spacer */}
          <div className="flex-1" />

          {/* Carrinho */}
          <button
            onClick={() => setCartOpen(true)}
            className="relative flex items-center gap-2 rounded-lg border border-neutral-700 bg-neutral-900 hover:bg-neutral-800 transition-colors px-3 py-1.5"
          >
            <span className="text-sm">🛒</span>
            <span className="text-sm font-bold text-neutral-300">
              R$ {totalPreco.toFixed(2).replace(".", ",")}
            </span>
            {totalItems > 0 && (
              <span className="absolute -right-1.5 -top-1.5 flex h-4 w-4 items-center justify-center rounded-full bg-orange-600 text-[10px] font-black text-white">
                {totalItems}
              </span>
            )}
          </button>

          {/* Auth */}
          <div className="hidden items-center gap-2 md:flex">
            <button className="rounded-lg px-4 py-2 text-sm font-semibold text-neutral-300 hover:text-white hover:bg-neutral-800 transition-colors">
              Entrar
            </button>
            <button className="rounded-lg bg-orange-600 hover:bg-orange-500 transition-colors px-4 py-2 text-sm font-bold text-white">
              Criar conta
            </button>
          </div>
        </div>

        {/* Linha 2: Delivery / Retirada + endereço + loja */}
        <div className="border-t border-neutral-800/60 bg-neutral-900/40">
          <div className="mx-auto flex max-w-7xl items-center gap-3 px-4 py-2 md:px-8">
            {/* Toggle Delivery / Retirada */}
            <div className="flex items-center gap-1 rounded-full border border-neutral-700 bg-neutral-900 p-0.5">
              <button
                onClick={() => setModo("delivery")}
                className={`rounded-full px-4 py-1.5 text-xs font-bold transition-colors ${
                  modo === "delivery"
                    ? "bg-neutral-700 text-white"
                    : "text-neutral-400 hover:text-white"
                }`}
              >
                Delivery
              </button>
              <button
                onClick={() => setModo("retirada")}
                className={`rounded-full px-4 py-1.5 text-xs font-bold transition-colors ${
                  modo === "retirada"
                    ? "bg-orange-600 text-white"
                    : "text-neutral-400 hover:text-white"
                }`}
              >
                Retirada
              </button>
            </div>

            {/* Endereço */}
            <button className="hidden items-center gap-1.5 rounded-lg px-2 py-1.5 text-xs text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors sm:flex">
              <span>📍</span>
              <span className="max-w-[180px] truncate">Rua José Vila Busquets, 16...</span>
              <span className="text-neutral-600">▾</span>
            </button>

            <div className="hidden h-4 w-px bg-neutral-700 sm:block" />

            {/* Loja */}
            <button className="hidden items-center gap-1.5 rounded-lg px-2 py-1.5 text-xs text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors sm:flex">
              <span>🏪</span>
              <span className="font-semibold text-neutral-300">VenoZza · Santo Amaro</span>
              <span className="text-neutral-600">▾</span>
            </button>

            <div className="flex-1" />

            {/* Carrinho resumido direita */}
            <button
              onClick={() => setCartOpen(true)}
              className="flex items-center gap-2"
            >
              <span>🛒</span>
              <div className="text-right">
                <p className="text-xs font-bold text-neutral-300">R$ {totalPreco.toFixed(2).replace(".", ",")}</p>
                <p className="text-[10px] text-neutral-500">{totalItems} {totalItems === 1 ? "item" : "itens"}</p>
              </div>
            </button>
          </div>
        </div>
      </nav>

      {/* ── HERO ── */}
      <section className="relative z-10 mx-auto max-w-6xl px-6 pb-16 pt-20 md:px-12 md:pt-28">
        <p className="mb-4 inline-flex items-center gap-2 rounded-full border border-orange-900/50 bg-orange-950/40 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-orange-400">
          <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-orange-400" />
          Entrega em ~35 min
        </p>
        <h1 className="text-5xl font-black leading-[1.05] tracking-tight md:text-7xl">
          Pizza de
          <br />
          <span className="text-orange-500">verdade,</span>
          <br />
          na sua porta.
        </h1>
        <p className="mt-5 max-w-lg text-lg text-neutral-400">
          Massa artesanal, ingredientes frescos. Monte seu pedido abaixo e receba rápido.
        </p>
        <a
          href="#cardapio"
          className="mt-8 inline-flex items-center gap-2 rounded-full bg-orange-600 hover:bg-orange-500 transition-colors px-8 py-4 text-base font-bold"
        >
          Ver cardápio ↓
        </a>

        <div className="pointer-events-none absolute right-4 top-8 hidden select-none text-[14rem] opacity-[0.07] md:block" aria-hidden>
          🍕
        </div>
      </section>

      {/* ── STATS ── */}
      <div className="relative z-10 border-y border-neutral-800 bg-neutral-900/30">
        <div className="mx-auto grid max-w-6xl grid-cols-2 md:grid-cols-4">
          {[
            { v: "+2.000", l: "pedidos entregues" },
            { v: "4.9 ★", l: "avaliação média" },
            { v: "~35 min", l: "tempo médio" },
            { v: "20+", l: "sabores" },
          ].map((s, i) => (
            <div key={i} className="border-r border-neutral-800 last:border-r-0 px-6 py-6 text-center odd:border-b md:odd:border-b-0">
              <p className="text-2xl font-black text-orange-400">{s.v}</p>
              <p className="mt-0.5 text-xs text-neutral-500">{s.l}</p>
            </div>
          ))}
        </div>
      </div>

      {/* ── CARDÁPIO ── */}
      <section id="cardapio" className="relative z-10 mx-auto max-w-6xl px-6 py-20 md:px-12">
        <p className="mb-1 text-xs font-semibold uppercase tracking-widest text-orange-500">Cardápio</p>
        <h2 className="mb-8 text-3xl font-black md:text-4xl">Escolha sua pizza</h2>

        {/* Categorias — scroll horizontal */}
        <div className="relative mb-10">
          <div className="flex gap-2 overflow-x-auto pb-2 scrollbar-none" style={{scrollbarWidth:"none"}}>
            {categorias.map((cat) => (
              <button
                key={cat.id}
                onClick={() => setCatAtiva(cat.id)}
                className={`flex shrink-0 items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-bold transition-all ${
                  catAtiva === cat.id
                    ? "border-orange-600 bg-orange-600 text-white"
                    : "border-neutral-700 bg-neutral-900 text-neutral-400 hover:border-neutral-500 hover:text-white"
                }`}
              >
                <span className="text-base">{cat.icone}</span>
                {cat.nome}
              </button>
            ))}
          </div>
        </div>

        {/* Grid de produtos */}
        <div className="grid gap-3 sm:grid-cols-2">
          {produtos
            .filter((p) => p.cat === catAtiva)
            .map((prod) => {
              const qty = qtyOf(prod.id);
              return (
                <div
                  key={prod.id}
                  className="relative flex items-center gap-4 rounded-2xl border border-neutral-800 bg-neutral-900/60 p-4 transition-all hover:border-orange-900/60"
                >
                  {/* Imagem / emoji */}
                  <div className="flex h-20 w-20 shrink-0 items-center justify-center rounded-xl bg-neutral-800 text-4xl">
                    {prod.emoji}
                  </div>

                  {/* Info */}
                  <div className="flex flex-1 flex-col gap-1 min-w-0">
                    <div className="flex items-start justify-between gap-2">
                      <h3 className="text-sm font-bold leading-tight">{prod.nome}</h3>
                      {prod.tag && (
                        <span className="shrink-0 rounded-full bg-orange-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide">
                          {prod.tag}
                        </span>
                      )}
                    </div>
                    <p className="text-xs leading-relaxed text-neutral-500 line-clamp-2">{prod.desc}</p>
                    <div className="mt-1 flex items-center justify-between">
                      <span className="text-base font-black text-orange-400">
                        R$ {prod.preco.toFixed(2).replace(".", ",")}
                      </span>

                      {qty === 0 ? (
                        <button
                          onClick={() => addToCart(prod)}
                          className="rounded-full bg-orange-600 hover:bg-orange-500 transition-colors px-3 py-1.5 text-xs font-bold"
                        >
                          Adicionar
                        </button>
                      ) : (
                        <div className="flex items-center gap-2">
                          <button
                            onClick={() => removeFromCart(prod.id)}
                            className="flex h-7 w-7 items-center justify-center rounded-full border border-neutral-700 hover:border-neutral-500 font-bold transition-colors"
                          >
                            −
                          </button>
                          <span className="w-4 text-center text-sm font-bold">{qty}</span>
                          <button
                            onClick={() => addToCart(prod)}
                            className="flex h-7 w-7 items-center justify-center rounded-full bg-orange-600 hover:bg-orange-500 font-bold transition-colors"
                          >
                            +
                          </button>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
        </div>
      </section>

      {/* ── COMO FUNCIONA ── */}
      <section className="relative z-10 border-t border-neutral-800 bg-neutral-900/20">
        <div className="mx-auto max-w-6xl px-6 py-20 md:px-12">
          <p className="mb-1 text-xs font-semibold uppercase tracking-widest text-orange-500">Simples assim</p>
          <h2 className="mb-10 text-3xl font-black md:text-4xl">Como funciona</h2>
          <div className="grid gap-8 md:grid-cols-3">
            {[
              { n: "01", t: "Monte seu pedido", d: "Adicione as pizzas que quiser direto no cardápio acima." },
              { n: "02", t: "Informe o endereço", d: "Diga onde entregar e escolha a forma de pagamento." },
              { n: "03", t: "Aguarde na porta", d: "Acompanhe o pedido em tempo real. Pizza em ~35 min." },
            ].map((s) => (
              <div key={s.n} className="flex gap-5">
                <span className="shrink-0 text-4xl font-black text-neutral-800 select-none">{s.n}</span>
                <div>
                  <h3 className="font-bold">{s.t}</h3>
                  <p className="mt-1 text-sm text-neutral-500">{s.d}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── FOOTER ── */}
      <footer className="relative z-10 border-t border-neutral-800 px-6 py-8 text-center text-sm text-neutral-600">
        © {new Date().getFullYear()} VenoZza · Todos os direitos reservados
      </footer>

      {/* ── CARRINHO (drawer) ── */}
      {cartOpen && (
        <div className="fixed inset-0 z-50 flex justify-end">
          <div
            className="absolute inset-0 bg-black/60 backdrop-blur-sm"
            onClick={() => setCartOpen(false)}
          />
          <div className="relative flex h-full w-full max-w-md flex-col bg-[#130e08] shadow-2xl">
            <div className="flex items-center justify-between border-b border-neutral-800 px-6 py-5">
              <h2 className="text-lg font-black">Seu pedido</h2>
              <button
                onClick={() => setCartOpen(false)}
                className="text-2xl leading-none text-neutral-400 hover:text-white"
              >
                ×
              </button>
            </div>

            <div className="flex-1 overflow-y-auto px-6 py-4">
              {cart.length === 0 ? (
                <div className="mt-16 text-center text-neutral-500">
                  <p className="text-4xl">🍕</p>
                  <p className="mt-3 text-sm">Nenhuma pizza ainda.<br />Adicione do cardápio!</p>
                </div>
              ) : (
                <ul className="space-y-4">
                  {cart.map((item) => (
                    <li key={item.id} className="flex items-center justify-between gap-4">
                      <div className="flex-1">
                        <p className="text-sm font-semibold">{item.nome}</p>
                        <p className="text-xs text-neutral-500">R$ {item.preco} × {item.qty}</p>
                      </div>
                      <div className="flex items-center gap-2">
                        <button
                          onClick={() => removeFromCart(item.id)}
                          className="flex h-7 w-7 items-center justify-center rounded-full border border-neutral-700 text-sm font-bold hover:border-neutral-500"
                        >
                          −
                        </button>
                        <span className="w-4 text-center text-sm font-bold">{item.qty}</span>
                        <button
                          onClick={() => {
                            const p = produtos.find((p) => p.id === item.id)!;
                            addToCart(p);
                          }}
                          className="flex h-7 w-7 items-center justify-center rounded-full bg-orange-600 hover:bg-orange-500 text-sm font-bold"
                        >
                          +
                        </button>
                      </div>
                      <span className="w-16 text-right text-sm font-bold text-orange-400">
                        R$ {item.preco * item.qty}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            {cart.length > 0 && (
              <div className="border-t border-neutral-800 px-6 py-5">
                <div className="mb-4 flex justify-between">
                  <span className="text-sm text-neutral-400">Total</span>
                  <span className="text-xl font-black text-orange-400">R$ {totalPreco}</span>
                </div>
                <Link
                  href="/m/checkout"
                  onClick={() => setCartOpen(false)}
                  className="block w-full rounded-full bg-orange-600 hover:bg-orange-500 transition-colors py-4 text-center text-base font-bold"
                >
                  Finalizar pedido →
                </Link>
              </div>
            )}
          </div>
        </div>
      )}

      {/* ── BARRA FLUTUANTE MOBILE ── */}
      {totalItems > 0 && !cartOpen && (
        <div className="fixed bottom-6 left-1/2 z-40 -translate-x-1/2 md:hidden">
          <button
            onClick={() => setCartOpen(true)}
            className="flex items-center gap-3 rounded-full bg-orange-600 px-6 py-3.5 text-sm font-bold shadow-lg shadow-orange-900/40"
          >
