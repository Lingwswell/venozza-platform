import Link from "next/link";

const categorias = [
  { id: "pizzas",      icone: "🍕", nome: "Pizzas" },
  { id: "bordas",      icone: "🧀", nome: "Bordas" },
  { id: "bebidas",     icone: "🥤", nome: "Bebidas" },
  { id: "sobremesas",  icone: "🍰", nome: "Sobremesas" },
  { id: "novidades",   icone: "✨", nome: "Novidades" },
