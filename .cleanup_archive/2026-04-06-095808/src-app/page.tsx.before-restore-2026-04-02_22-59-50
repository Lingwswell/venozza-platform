  { id: 5,  cat: "pizzas",     emoji: "🧀", nome: "Quatro Queijos",       desc: "Mussarela, provolone, gorgonzola e parmesão ao forno", preco: 59, tag: null },
  { id: 6,  cat: "pizzas",     emoji: "🍯", nome: "Frango com Mel",       desc: "Frango grelhado, molho de mel e mostarda, cebola crispy", preco: 58, tag: null },
  // Bordas
  { id: 7,  cat: "bordas",     emoji: "🧀", nome: "Borda de Catupiry",    desc: "Borda recheada com catupiry cremoso", preco: 12, tag: null },
  { id: 8,  cat: "bordas",     emoji: "🍫", nome: "Borda de Chocolate",   desc: "Borda recheada com chocolate ao leite", preco: 14, tag: null },
  { id: 9,  cat: "bordas",     emoji: "🫒", nome: "Borda de Cheddar",     desc: "Borda recheada com cheddar cremoso", preco: 13, tag: "Favorita" },
  // Bebidas
  { id: 10, cat: "bebidas",    emoji: "🥤", nome: "Coca-Cola",            desc: "Lata, 600ml ou 2L.", preco: 10.50, tag: null },
  { id: 11, cat: "bebidas",    emoji: "🥤", nome: "Coca-Cola Zero",       desc: "Lata, 600ml ou 2L.", preco: 10.50, tag: null },
  { id: 12, cat: "bebidas",    emoji: "🥤", nome: "Fanta Guaraná",        desc: "Lata, 600ml ou 2L.", preco: 10.50, tag: null },
  { id: 13, cat: "bebidas",    emoji: "🥤", nome: "Sprite",               desc: "Lata, 600ml ou 2L.", preco: 10.50, tag: null },
